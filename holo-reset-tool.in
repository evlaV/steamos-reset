#!/bin/bash

set -eu

# SPDX-License-Identifier: GPL-2.0+

# Copyright © 2022 Collabora Ltd
# Copyright © 2022 Valve Corporation

declare -r EXECDIR=@prefix@/share/@PACKAGE@/cgi
declare LAST_MESSAGE=
declare LAST_STATUS=
declare LAST_UUID=

usage ()
{
    echo "Usage: $0 <mode>"
    echo ""
    echo "Modes:"
    echo "    factory-reset  [--reset-os] [--reset-user-data] [--reset-all]"
    echo "    help"
    echo "    (deprecated) os-status"
}

wait_for_session ()
{
    local uuid=$1
    local status=0
    local spin=1
    local log_idx=0
    local JSON

    while [ $spin -eq 1 ]
    do
        if [ $status -ge 200 ]
        then
            LAST_UUID="$uuid"
            spin=0
        elif [ $status -eq 0 ] || [ $status -eq 102 ]
        then
            JSON=$(${EXECDIR}/status uuid="$uuid" start=$log_idx)
            status=$(echo "$JSON" | jq -rc ".status_list[\"$uuid\"][0]")
            log_idx=$(echo "$JSON" | jq -rc ".status_list[\"$uuid\"][4]")
            while read msg
            do
                echo "$msg" >&2
                LAST_MESSAGE="$msg"
            done < <(echo "$JSON" | jq -rc ".log_messages[]")
        fi
    done

    LAST_STATUS="$status"

    if [ $status -eq 200 ]
    then
        return 0
    else
        return 1
    fi
}

execute_backend ()
{
    local -r backend=$1; shift
    local JSON=$(${EXECDIR}/$backend "$@")
    local -i rv=0

    LAST_MESSAGE=
    LAST_STATUS=
    LAST_UUID=

    local service uuid status message

    read status service uuid < \
         <(echo "$JSON" | jq -rc '"\(.status) \(.service) \(.uuid)"')

    if [ -n "$uuid" ] && [ "$uuid" != "null" ]
    then
        if ! wait_for_session "$uuid";
        then
            rv=1
        fi

        JSON=$(${EXECDIR}/status uuid="$uuid")
        read status  < <(echo "$JSON" | jq -rc ".status_list[\"$uuid\"][0]")
        read msg     < <(echo "$JSON" | jq -rc ".log_messages[-1]")
        msg=${msg//\"/\\\"}

	LAST_MESSAGE=$msg
	LAST_STATUS=$status
	LAST_UUID=$uuid

        return $rv;            
    else
        LAST_STATUS=$status
        if [ $status -ne 200 ]; then return 1; fi
        return 0
    fi
}

completed_sessions ()
{
    ${EXECDIR}/status | \
        jq -cr '.status_list|to_entries[]|select(.value[0]!=102 or .value[3]==0)|.key'
}

delete_completed_sessions ()
{
    local uuid x
    while read uuid x
    do
	status=$(${EXECDIR}/clear uuid="$uuid" | jq -rc '"\(.status)"')
        if [ $status -ne 200 ]
	then
	    echo "Failed to clear $uuid"
	    return 1
	fi
    done < <(completed_sessions)
}

factory_reset ()
{
    local arg uuid=null
    local arg reset_os_args=
    local arg reset_user_data_args=

    for arg in "$@"
    do
        case $arg in
            --reset-os) reset_os_args="--reset-os"; ;;
            --reset-user-data) reset_user_data_args="--reset-user-data"; ;;
            --reset-all) reset_os_args="--reset-all"; ;;
        esac
    done

    trap delete_completed_sessions EXIT

    execute_backend factory-reset $reset_os_args $reset_user_data_args
    if [ "$?" = "1" ]
    then
        echo "Error: $LAST_MESSAGE" >&2
    fi
}

declare -r verb=${1:-help}; shift || true

case $verb in
    os-status)
        ;;
    factory-reset)
        factory_reset "$@"
        ;;
    help)
	usage
	;;
    *)
        echo "$0: Unrecognised action \"$verb\""
        exit 1
        ;;
esac
